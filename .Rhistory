obs_div_df <-
iNEXT_manual_df %>%
dplyr::filter(Method == "Observed")
# check it
glimpse(obs_div_df)
obs_rich_df <-
obs_div_df %>%
dplyr::filter(Order.q == 0)
shapiro.test(obs_rich_df$qD)
obs_shannon_df <-
obs_div_df %>%
dplyr::filter(Order.q == 1)
shapiro.test(obs_shannon_df$qD)
obs_simps_df <-
obs_div_df %>%
dplyr::filter(Order.q == 2)
shapiro.test(obs_simps_df$qD)
obs_div_df %>%
ggplot(aes(x = tissue_group, y = qD, fill = tissue_group,
color = tissue_group)) +
facet_wrap(.~Order.q, scales = "free_y") +
geom_jitter(width = 0.15) +
geom_boxplot(alpha = 0.5, outlier.shape = NA) +
labs(y = "Effective Number of ASVs") +
theme_bw() +
theme(legend.position = "bottom",
axis.title.x = element_blank())
# Pull out richness data
obs_rich_df <-
obs_div_df %>%
dplyr::filter(Order.q == 0)
# Calculate Wilcoxon test
wilcox_tissueGroup_rich <-
wilcox.test(qD ~ tissue_group, data = obs_rich_df)
# Look at it
wilcox_tissueGroup_rich
# Richness by tissue group
rich_ggboxplot <-
ggboxplot(obs_rich_df, x = "tissue_group", y = "qD",
color = "tissue_group", fill = "tissue_group", alpha = 0.3,
outlier.shape = NA) +
geom_jitter(aes(color = tissue_group), width = 0.15) +
labs(y = "# of Total ASVs (Richness)") +
stat_compare_means(method = "wilcox.test",
label.y = max(obs_rich_df$qD) * 1.05) +
theme_bw() +
theme(legend.position = "none",
axis.title.x = element_blank())
# Pull out shannon data
obs_shannon_df <-
obs_div_df %>%
dplyr::filter(Order.q == 1)
# Calculate Wilcoxon test
wilcox_tissueGroup_shannon <-
wilcox.test(qD ~ tissue_group, data = obs_shannon_df)
# Look at it
wilcox_tissueGroup_shannon
# Shannon by tissue group
shannon_ggboxplot <-
ggboxplot(obs_shannon_df, x = "tissue_group", y = "qD",
color = "tissue_group", fill = "tissue_group", alpha = 0.3,
outlier.shape = NA) +
geom_jitter(aes(color = tissue_group), width = 0.15) +
labs(y = "# of Common ASVs (Shannon)") +
stat_compare_means(method = "wilcox.test",
label.y = max(obs_shannon_df$qD) * 1.05) +
theme_bw() +
theme(legend.position = "none",
axis.title.x = element_blank())
# Pull out simpson data
obs_simps_df <-
obs_div_df %>%
dplyr::filter(Order.q == 2)
# Calculate Wilcoxon test
wilcox_tissueGroup_simps <-
wilcox.test(qD ~ tissue_group, data = obs_simps_df)
# Look at it
wilcox_tissueGroup_simps
# Simpson by tissue group
simps_ggboxplot <-
ggboxplot(obs_simps_df, x = "tissue_group", y = "qD",
color = "tissue_group", fill = "tissue_group", alpha = 0.3,
outlier.shape = NA) +
geom_jitter(aes(color = tissue_group), width = 0.15) +
labs(y = "# of Dominant ASVs (Simpson)") +
stat_compare_means(method = "wilcox.test",
label.y = max(obs_simps_df$qD) * 1.05) +
theme_bw() +
theme(legend.position = "none",
axis.title.x = element_blank())
rich_ggboxplot + shannon_ggboxplot + simps_ggboxplot
